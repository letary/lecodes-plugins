<?xml version="1.0" encoding="utf-8"?>
<!-- The privacy screen Health Connect opens from its permission sheet (HealthRationaleActivity).
     lecodes_privacy_policy_url — the APP's privacy policy, opened in the browser instead of the text
     (Google Play's Health Connect policy asks for the policy there): empty here, the app's value
     comes from app.json "privacyPolicy" (`lecodes app sync` writes it into the shell, whose resource
     wins over this one). lecodes_health_rationale — the text shown without one (%1$s: the app's
     name); an app may override it in its own res/values. -->
<resources>
    <string name="lecodes_privacy_policy_url" translatable="false"></string>
    <string name="lecodes_health_rationale_title">Health data</string>
    <string name="lecodes_health_rationale">%1$s reads the totals of your steps, distance and active energy from Health Connect to show your activity. It writes nothing to Health Connect.</string>
</resources>
