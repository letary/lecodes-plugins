<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the consuming app by the AGP manifest merger. READ_CALENDAR only: it stands behind
     calendars / list / get / show (asked at run time, through the host's permission service). The
     "new event" editor and an event's card are the Calendar app's own screens and need none - there
     is no WRITE_CALENDAR here, on purpose: a calendar permission in the merged manifest is declared
     in Play's Data safety form, which is why calendar is a plugin and not part of the SDK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALENDAR" />
</manifest>
